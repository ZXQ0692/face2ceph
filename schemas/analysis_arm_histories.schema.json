{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aggregate arm training histories",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "required": ["fraction", "selection_criterion", "folds"],
    "properties": {
      "fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
      "selection_criterion": {
        "enum": ["mae_mean", "balanced_accuracy_mean"]
      },
      "folds": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["fold", "n_train", "epochs"],
          "properties": {
            "fold": {"type": "integer", "minimum": 0},
            "n_train": {"type": "integer", "minimum": 2},
            "epochs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["epoch", "mae_mean", "balanced_accuracy_sagittal", "balanced_accuracy_vertical"],
                "properties": {
                  "epoch": {"type": "integer", "minimum": 0},
                  "mae_mean": {"type": ["number", "null"]},
                  "balanced_accuracy_sagittal": {"type": "number", "minimum": 0, "maximum": 1},
                  "balanced_accuracy_vertical": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {"selection_criterion": {"const": "mae_mean"}},
          "required": ["selection_criterion"]
        },
        "then": {
          "properties": {
            "folds": {
              "items": {
                "properties": {
                  "epochs": {
                    "items": {
                      "properties": {"mae_mean": {"type": "number"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    ],
    "additionalProperties": false
  }
}
